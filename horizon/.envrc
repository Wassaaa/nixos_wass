use nix

export HORIZON_MSA_CLIENT_ID=331e08f8-172d-43b9-835a-3108c2fcdbf3

horizon_alsa=$(nix-build '<nixpkgs>' -A alsa-lib --no-out-link) || return 1
horizon_udev=$(nix-build '<nixpkgs>' -A systemd --no-out-link) || return 1
horizon_udev_dev=$(nix-build '<nixpkgs>' -A systemd.dev --no-out-link) || return 1

export PKG_CONFIG_PATH="$horizon_udev_dev/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
export LD_LIBRARY_PATH="$horizon_alsa/lib:$horizon_udev/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export NIX_LD_LIBRARY_PATH="$horizon_alsa/lib:$horizon_udev/lib${NIX_LD_LIBRARY_PATH:+:$NIX_LD_LIBRARY_PATH}"
