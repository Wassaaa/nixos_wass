{
  host,
  lib,
  flakeRoot,
  ...
}:
let
  inherit (import "${flakeRoot}/hosts/${host}/variables.nix")
    monitors
    ;

  enabledMonitors = lib.filter (m: m.enabled) monitors;
  disabledMonitors = lib.filter (m: !m.enabled) monitors;

  monitorLines = map (
    m:
    let
      resolution = "${toString m.width}x${toString m.height}@${toString m.refreshRate}";
      position = "${toString m.x}x${toString m.y}";
    in
    ''
      hl.monitor({
        output = "${m.name}",
        mode = "${resolution}",
        position = "${position}",
        scale = 1,
      })
    ''
  ) enabledMonitors;

  disabledMonitorLines = map (m: ''
    hl.monitor({
      output = "${m.name}",
      disabled = true,
    })
  '') disabledMonitors;

  workspaceLines = builtins.concatMap (
    m:
    if m.workspace == null then
      [ ]
    else
      map (workspace: ''
        hl.workspace_rule({
          workspace = "${workspace}",
          monitor = "${m.name}",
        })
      '') m.workspace
  ) enabledMonitors;
in
''
  -- Generated by monitors.nix -- do not edit directly.

  ${builtins.concatStringsSep "\n" monitorLines}

  ${builtins.concatStringsSep "\n" disabledMonitorLines}

  ${builtins.concatStringsSep "\n" workspaceLines}
''
