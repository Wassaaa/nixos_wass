{
  host,
  lib,
  flakeRoot,
  ...
}:
let
  variables = import "${flakeRoot}/hosts/${host}/variables.nix";
  inherit (variables) monitors;
  profiles = variables.monitorProfiles or [ { name = "Default"; overrides = { }; } ];
  monitorNames = map (m: m.name) monitors;
  renderMonitor = m: ''
    {
      output = ${builtins.toJSON m.name},
      disabled = ${if m.enabled then "false" else "true"},
      mode = ${builtins.toJSON "${toString m.width}x${toString m.height}@${toString m.refreshRate}"},
      position = ${builtins.toJSON "${toString m.x}x${toString m.y}"},
      scale = 1,
    }
  '';
  renderProfile = profile:
    let
      overrides = profile.overrides or { };
      configured = map (m: m // (overrides.${m.name} or { })) monitors;
      unknown = lib.subtractLists monitorNames (builtins.attrNames overrides);
      mergeTo = profile.mergeTo or null;
    in
    assert lib.assertMsg (unknown == [ ]) "Monitor profile '${profile.name}' has unknown outputs: ${lib.concatStringsSep ", " unknown}";
    assert lib.assertMsg (lib.any (m: m.enabled) configured) "Monitor profile '${profile.name}' must enable at least one output";
    assert lib.assertMsg (mergeTo == null || lib.any (m: m.name == mergeTo && m.enabled) configured) "Monitor profile '${profile.name}' has an invalid mergeTo output";
    ''
      {
        name = ${builtins.toJSON profile.name},
        mergeTo = ${if mergeTo == null then "nil" else builtins.toJSON mergeTo},
        monitors = { ${lib.concatMapStringsSep ",\n" renderMonitor configured} },
      }
    '';
in
{
  xdg.configFile."hypr/monitors.lua".text =
    assert lib.assertMsg (profiles != [ ]) "At least one monitor profile is required";
    assert lib.assertMsg (lib.length (lib.unique (map (p: p.name) profiles)) == lib.length profiles) "Monitor profile names must be unique";
    assert lib.assertMsg (lib.all (p: p.name != "" && !(lib.hasInfix "\n" p.name)) profiles) "Monitor profile names must be nonempty and single-line";
    assert lib.assertMsg (lib.length (lib.unique monitorNames) == lib.length monitorNames) "Monitor names must be unique";
    ''
    -- Generated by monitors.nix -- do not edit directly.
    require("monitor-profiles").setup({
      ${lib.concatMapStringsSep ",\n" renderProfile profiles}
    })
  '';
}
