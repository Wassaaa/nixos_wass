if declare -F nix_direnv_disallow_fallback >/dev/null; then
  nix_direnv_disallow_fallback
fi

use flake || {
  log_error "Failed to load the WassOS development shell"
  exit 1
}

if [[ ! -f "${WASSOS_HYPRLAND_LUA_STUBS:-}/hl.meta.lua" ]]; then
  log_error "The Hyprland Lua API stubs are missing from the development shell"
  exit 1
fi

mkdir -p .direnv || {
  log_error "Could not create the direnv directory"
  exit 1
}
stub_link="$PWD/.direnv/hyprland-lua"
if [[ -e "$stub_link" && ! -L "$stub_link" ]]; then
  log_error "Refusing to replace non-symlink $stub_link"
  exit 1
fi
ln -sfnT -- "$WASSOS_HYPRLAND_LUA_STUBS" "$stub_link" || {
  log_error "Could not link the Hyprland Lua API stubs"
  exit 1
}
